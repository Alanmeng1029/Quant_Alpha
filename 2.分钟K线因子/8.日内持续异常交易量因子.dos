/**
日内持续异常交易量因子

- 异常交易量：当前分钟交易量与过去一段时间分钟交易量均值的比值（本例中为过去 10 个交易时刻）
- 日内持续异常交易量：股票异常交易量的排名百分位的均值除以标准差，加上其峰度

DolphinDB server version:3.00.2.5 2025.05.26 LINUX x86_64
DolphinDB server version:2.00.15 2025.01.20 LINUX x86_64(test)
Storage engine: TSDB
Last modification time: 2025.10.30
*/

//自定义因子计算函数
def PATV(minKTB){
    /**@test 少量数据临时调试
    minKTB = 
        select SecurityID, date(DateTime) as TradeDate, time(DateTime) as TradeTime, LastPx, Volume
        from loadTable("dfs://stockMinKSH", "stockMinKSH")
        where date(DateTime)=2021.01.04, LastPx>0
    */
    //计算异常交易量
    ATV = 
        select 
            SecurityID,
            TradeDate,
            TradeTime,
            Volume\mavg(Volume, 10) as volProp
        from minKTB
        context by SecurityID, TradeDate
    //计算异常交易量排名
    rankATV = 
        select
            SecurityID,
            TradeDate,
            TradeTime,
            rank(x=volProp, percent=true) as rankATV
        from ATV 
        context by TradeDate, TradeTime
    //日内持续异常交易量：股票异常交易量的排名百分位的均值除以标准差，加上其峰度
    res =
        select
            SecurityID,
            TradeDate,
            mean(rankATV)\std(rankATV)+kurtosis(rankATV) as Value,
            "PATV" as factorName,
            now() as updateTime
        from rankATV
        group by SecurityID, TradeDate
    return res
}

//后台任务计算函数模版
def factorjob(conf){
    dataTB = loadTable(conf[`dataDB], conf[`dataTB])
    days = conf[`startDay]..conf[`endDay]
    startTime = 09:30:00.000
    endTime = 14:57:00.000
    //提取计算所需数据，repartitionDS 重新按照日期分区并生成元代码
    ds = repartitionDS(<select SecurityID, date(DateTime) as TradeDate, time(DateTime) as TradeTime, LastPx, Volume
        from dataTB
        where date(DateTime) in days and (time(DateTime) between startTime and endTime) and (SecurityID like "00%" or SecurityID like "30%" or SecurityID like "6%") and LastPx>0>, `DateTime, VALUE, 2021.01.01..2021.12.31)
    //计算因子，mr函数将因子在不同节点并行计算，unionAll函数将不同节点的计算结果汇总
    res = mr(ds, conf[`func]).unionAll()
    //写入因子库，存储到磁盘做持久化
    loadTable(conf[`factorDB], conf[`factorTB]).append!(select * from res)
}

//计算模版配置参数
conf = {
    func : PATV,
    funcsec : NULL,
    factorname : "PATV",
    dataDB : "dfs://stockMinKSH",
    dataTB : "stockMinKSH",
    factorDB : "dfs://factor_day",
    factorTB : "factor_day",
    startDay : 2021.01.01,
    endDay : 2021.01.31
}

//提交计算和存储因子的任务到服务器
id = submitJob("factorjob", conf[`factorname], factorjob, conf)

//查看任务完成情况
getJobStatus(id)

//3个月计算耗时
(2025.07.03 23:22:24.168-2025.07.03 23:20:47.453)\1000 //96s 无缓存，全部从磁盘读取L2原始行情

//因子数据查看
data = select * from loadTable("dfs://factor_day","factor_day") where TradeDate=2021.01.04, SecurityID in `000001, factorname="PATV"

select count(*) from loadTable("dfs://factor_day","factor_day") where factorname="PATV" group by TradeDate

select (endTime-startTime)\1000 from getJobStatus(id)
