/**
成交量“潮汐”的价格变动速率因子

- 领域成交量：日内第 n 分钟及其前后 4 分钟的总成交量
- 顶峰时刻：领域成交量最大值所在时刻
- 涨潮时刻：顶峰时刻前领域成交量最低点所在时刻 m
- 退潮时刻：顶峰时刻后领域成交量最低点所在时刻 n
- 潮汐价格变动速率：涨潮时刻较退潮时刻的收盘价变动速率除以 n-m

DolphinDB server version:3.00.2.5 2025.05.26 LINUX x86_64
DolphinDB server version:2.00.15 2025.01.20 LINUX x86_64(test)
Storage engine: TSDB
Last modification time: 2025.10.30
*/

//自定义因子计算函数
def volTideRatio(minKTB){
    /**@test 少量数据临时调试
    minKTB = 
        select SecurityID, date(DateTime) as TradeDate, time(DateTime) as TradeTime, LastPx, Volume
        from loadTable("dfs://stockMinKSH", "stockMinKSH")
        where date(DateTime)=2021.01.04, SecurityID in `603189`000001 and LastPx>0
    */
    //计算领域成交量
    adjVolTB = 
        select 
            SecurityID,
            TradeDate,
            TradeTime,
            LastPx,
            move(msum(Volume, 9), -4) as adjVol,
            rowNo(TradeTime) as num
        from minKTB
        context by SecurityID, TradeDate
    //顶峰时刻
    threshold = 
        select
            SecurityID,
            TradeDate,
            aggrTopN(first, num, adjVol, 1, false) as tideNum,
            max(adjVol) as thresholdVol
        from adjVolTB
        group by SecurityID, TradeDate
    //涨潮时刻
    rise = 
        select
            SecurityID,
            TradeDate,
            aggrTopN(first, num, adjVol, 1, true) as riseNum,
            aggrTopN(first, LastPx, adjVol, 1, true) as risePrice
        from lj(adjVolTB, threshold, `SecurityID`TradeDate)
        where num<tideNum and adjVol is not null
        group by SecurityID, TradeDate
    //退潮时刻
    fall = 
        select
            SecurityID,
            TradeDate,
            aggrTopN(first, num, adjVol, 1, true) as fallNum,
            aggrTopN(first, LastPx, adjVol, 1, true) as fallPrice
        from lj(adjVolTB, threshold, `SecurityID`TradeDate)
        where num>tideNum and adjVol is not null
        group by SecurityID, TradeDate
    //成交额占比熵=成交额占比的熵
    res =
        select
            SecurityID,
            TradeDate,
            ((risePrice\fallPrice)-1)\(fallNum-riseNum) as Value,
            "volTideRatio" as factorName,
            now() as updateTime
        from lj(rise, fall, `SecurityID`TradeDate)
        group by SecurityID, TradeDate
    return res
}

//后台任务计算函数模版
def factorjob(conf){
    dataTB = loadTable(conf[`dataDB], conf[`dataTB])
    days = conf[`startDay]..conf[`endDay]
    startTime = 09:30:00.000
    endTime = 14:57:00.000
    //提取计算所需数据，sqlDS生成元代码
    ds = sqlDS(<select SecurityID, date(DateTime) as TradeDate, time(DateTime) as TradeTime, LastPx, Volume
        from dataTB
        where date(DateTime) in days and (time(DateTime) between startTime and endTime) and (SecurityID like "00%" or SecurityID like "30%" or SecurityID like "6%") and LastPx>0>)
    //计算因子，mr函数将因子在不同节点并行计算，unionAll函数将不同节点的计算结果汇总
    res = mr(ds, conf[`func]).unionAll()
    //写入因子库，存储到磁盘做持久化
    loadTable(conf[`factorDB], conf[`factorTB]).append!(select * from res)
}

//计算模版配置参数
conf = {
    func : volTideRatio,
    funcsec : NULL,
    factorname : "volTideRatio",
    dataDB : "dfs://stockMinKSH",
    dataTB : "stockMinKSH",
    factorDB : "dfs://factor_day",
    factorTB : "factor_day",
    startDay : 2021.01.01,
    endDay : 2021.01.31
}

//提交计算和存储因子的任务到服务器
id = submitJob("factorjob", conf[`factorname], factorjob, conf)

//查看任务完成情况
getJobStatus(id)

//3个月计算耗时
(2025.07.03 23:22:24.168-2025.07.03 23:20:47.453)\1000 //96s 无缓存，全部从磁盘读取L2原始行情

//因子数据查看
data = select * from loadTable("dfs://factor_day","factor_day") where TradeDate=2021.01.04, SecurityID in `603189, factorname="volTideRatio"

select count(*) from loadTable("dfs://factor_day","factor_day") where factorname="volTideRatio" group by TradeDate

select (endTime-startTime)\1000 from getJobStatus(id)